{
  "name": "brayness",
  "version": "1.0.1",
  "description": "Brayness - a harness for your anxious digital brain",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "sessions": [
      "./sessions"
    ]
  },
  "scripts": {
    "brayness": "./bin/pi",
    "start": "npm run brayness",
    "test": "node --test --experimental-strip-types extensions/memory/index-db.test.ts extensions/edit-log/log.test.ts",
    "check:ext": "node ./bin/no-mjs.js",
    "pi:update": "rm -rf ~/.npm/_npx && npx --yes @earendil-works/pi-coding-agent update --all",
    "pi:list": "./bin/pi list",
    "feeds": "./skills/vault/rebuild-feeds.sh",
    "plans": "node ./bin/plans.js",
    "plans:build": "node ./bin/plans.js --build",
    "make:animation": "node ./bin/make-animation.js",
    "make:posters": "node ./bin/make-posters.js",
    "gallery": "node ./bin/gallery.js"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.14.1"
}
