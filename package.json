{
  "name": "brayness",
  "version": "1.0.1",
  "description": "Brayness - a harness for your anxious digital brain",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "sessions": [
      "./sessions"
    ]
  },
  "scripts": {
    "brayness": "./bin/pi",
    "start": "npm run brayness",
    "pi:update": "npm install @earendil-works/pi-coding-agent@latest && ./bin/pi update --extensions",
    "pi:list": "./bin/pi list",
    "feeds": "./skills/vault/rebuild-feeds.sh"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0"
  },
  "packageManager": "npm@11.14.1"
}
