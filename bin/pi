#!/usr/bin/env bash
root="$(cd "$(dirname "$0")/.." && pwd)"
export PI_CODING_AGENT_DIR="$root/.pi/agent"

# Canary: pi state must live in this repo. If ~/.pi exists, something ran pi
# without this wrapper and leaked config/sessions outside the harness.
if [[ -e "$HOME/.pi" ]]; then
  echo "~/.pi exists - pi state leaked outside the harness." >&2
  echo "Inspect it (ls -la ~/.pi), fold anything unique into $root, then delete it." >&2
  exit 1
fi

node_ok() {
  local ver major minor
  ver="$("$1" -v 2>/dev/null)" || return 1
  ver="${ver#v}"
  IFS=. read -r major minor _ <<< "$ver"
  (( major > 22 )) && return 0
  (( major == 22 && minor >= 19 )) && return 0
  return 1
}

best_node=""

consider_node() {
  [[ -n "$1" && -x "$1" ]] || return
  node_ok "$1" && best_node="$1"
}

consider_node "$(command -v node 2>/dev/null)"

if [[ -z "$best_node" ]]; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  for nvm_sh in "$NVM_DIR/nvm.sh" "$(brew --prefix nvm 2>/dev/null)/nvm.sh"; do
    [[ -s "$nvm_sh" ]] || continue
    # shellcheck source=/dev/null
    . "$nvm_sh"
    consider_node "$(command -v node 2>/dev/null)"
    [[ -n "$best_node" ]] && break
  done
fi

if [[ -z "$best_node" ]]; then
  for candidate in $(ls -1d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -Vr); do
    consider_node "$candidate"
    [[ -n "$best_node" ]] && break
  done
fi

if [[ -z "$best_node" ]]; then
  echo "pi needs Node >= 22.19 (current: $(node -v 2>/dev/null || echo missing))" >&2
  echo "Fix: nvm install 24 && nvm use 24" >&2
  exit 1
fi

export PATH="$(dirname "$best_node"):$PATH"

# Run pi via npx - no local or global install required. First run fetches pi
# into the npx cache (~/.npm/_npx); later runs are fast and offline.
# Load skills from the real repo skills/ dir directly - no symlink under .pi/agent.
# --skill with a directory loads every skill inside it. Only add it for session
# runs; management subcommands (install/remove/update/list/config/auth) and
# informational flags don't accept --skill.
load_skills=1
for a in "$@"; do
  case "$a" in
    install|remove|uninstall|update|list|config|auth|--help|-h|--version|-v|--list-models) load_skills=0 ;;
  esac
  [[ "$load_skills" == 0 ]] && break
done
if [[ "$load_skills" == 1 ]]; then
  set -- "$@" --skill "$root/skills"
fi

# A pi already on PATH wins over npx. npx deliberately ignores global installs,
# so without this a hosted image that ships a pinned pi would still fetch one
# from the registry on every session start - slow, and impossible offline. On a
# machine with no pi on PATH this falls through to npx below, unchanged. When pi
# is on PATH it is usually the same copy npx would have picked, so this is just
# the direct route to it. $root/bin/pi is skipped so a PATH that includes this
# repo cannot exec itself.
if pi_on_path="$(command -v pi 2>/dev/null)"; then
  if [[ "$pi_on_path" != "$root/bin/pi" ]]; then
    exec "$pi_on_path" "$@"
  fi
fi

# Run pi via npx - no local or global install required. First run fetches pi
# into the npx cache (~/.npm/_npx); later runs are fast and offline.
exec npx --yes @earendil-works/pi-coding-agent "$@"
